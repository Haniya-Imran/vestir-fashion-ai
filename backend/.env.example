# Paste your Groq API key here (get one at https://console.groq.com/keys)
GROQ_API_KEY=your_api_key_here

# Any current Groq chat model works — this is the default used if unset
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of origins allowed to call this API in production.
# Leave as * for local development.
ALLOWED_ORIGINS=*
